{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/package/schema/library.json",
  "name": "Flova ESP32",
  "version": "0.2.0",
  "description": "Flova ESP32 board package with plug-in and universal firmware entry points",
  "keywords": ["flova", "iot", "esp32", "arduino"],
  "homepage": "https://github.com/flova-platform/flova-firmware",
  "repository": {
    "type": "git",
    "url": "https://github.com/flova-platform/flova-firmware.git"
  },
  "authors": [
    {"name": "Flova", "url": "https://github.com/flova-platform/flova-firmware", "maintainer": true}
  ],
  "license": "MIT",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "headers": ["FlovaEsp32.h", "FlovaEsp32Ble.h", "FlovaUniversalEsp32.h", "FlovaUniversalEsp32Ble.h"],
  "build": { "includeDir": "include" },
  "dependencies": {
    "Flova Arduino": "^0.2.0"
  }
}
